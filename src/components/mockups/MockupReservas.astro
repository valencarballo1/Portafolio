---
interface Props { accent?: string }
const { accent = "#38d6ee" } = Astro.props;
const courts = ["Cancha 1", "Cancha 2", "Cancha 3", "Cancha 4"];
const hours = ["17:00", "18:00", "19:00", "20:00", "21:00"];
// 0 = libre · 1 = reservada · 2 = pendiente de pago
const grid = [
  [1, 1, 0, 1, 2],
  [0, 1, 1, 1, 0],
  [1, 0, 1, 2, 1],
  [1, 1, 0, 0, 1],
];
const cellW = 74, cellH = 46, gapX = 8, gapY = 10, originX = 96, originY = 108;
---

<svg viewBox="0 0 640 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-full w-full">
  <rect width="640" height="400" rx="14" fill="#0a1018" />
  <rect x="0.5" y="0.5" width="639" height="399" rx="13.5" stroke="rgba(255,255,255,0.09)" />

  <!-- chrome -->
  <path d="M0 14A14 14 0 0 1 14 0h612a14 14 0 0 1 14 14v18H0z" fill="rgba(255,255,255,0.035)" />
  <line x1="0" y1="32" x2="640" y2="32" stroke="rgba(255,255,255,0.08)" />
  <circle cx="18" cy="16" r="3.5" fill="rgba(255,255,255,0.18)" />
  <circle cx="30" cy="16" r="3.5" fill="rgba(255,255,255,0.13)" />
  <circle cx="42" cy="16" r="3.5" fill="rgba(255,255,255,0.13)" />
  <rect x="60" y="9" width="190" height="14" rx="7" fill="rgba(255,255,255,0.05)" />
  <text x="70" y="19.5" font-size="8" fill="rgba(255,255,255,0.4)" font-family="monospace">gestionclub</text>

  <!-- header -->
  <text x="24" y="58" font-size="13" font-weight="700" fill="rgba(255,255,255,0.92)" font-family="sans-serif">Reservas de hoy</text>
  <rect x="24" y="70" width="70" height="18" rx="9" fill={accent} fill-opacity="0.16" stroke={accent} stroke-opacity="0.4" />
  <text x="36" y="82.5" font-size="8" fill={accent} font-family="sans-serif">Hoy</text>
  <rect x="100" y="70" width="66" height="18" rx="9" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.08)" />
  <text x="111" y="82.5" font-size="8" fill="rgba(255,255,255,0.45)" font-family="sans-serif">Semana</text>
  <rect x="172" y="70" width="58" height="18" rx="9" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.08)" />
  <text x="183" y="82.5" font-size="8" fill="rgba(255,255,255,0.45)" font-family="sans-serif">Torneos</text>

  <!-- hour labels -->
  {hours.map((h, i) => (
    <text x={originX + i * (cellW + gapX) + cellW / 2} y="100" font-size="8" text-anchor="middle" fill="rgba(255,255,255,0.42)" font-family="sans-serif">{h}</text>
  ))}

  <!-- grid -->
  {grid.map((row, r) => (
    <g>
      <text x="24" y={originY + r * (cellH + gapY) + 27} font-size="9" fill="rgba(255,255,255,0.62)" font-family="sans-serif">{courts[r]}</text>
      {row.map((state, c) => {
        const x = originX + c * (cellW + gapX);
        const y = originY + r * (cellH + gapY);
        return (
          <g>
            <rect x={x} y={y} width={cellW} height={cellH} rx="8"
              fill={state === 1 ? accent : state === 2 ? "#f5b544" : "rgba(255,255,255,0.03)"}
              fill-opacity={state === 1 ? 0.2 : state === 2 ? 0.14 : 1}
              stroke={state === 1 ? accent : state === 2 ? "#f5b544" : "rgba(255,255,255,0.07)"}
              stroke-opacity={state === 0 ? 1 : 0.45} />
            {state !== 0 && (
              <g>
                <circle cx={x + 13} cy={y + 16} r="5" fill={state === 1 ? accent : "#f5b544"} fill-opacity="0.55" />
                <rect x={x + 22} y={y + 12.5} width={state === 1 ? 34 : 28} height="6" rx="3" fill="rgba(255,255,255,0.28)" />
                <rect x={x + 12} y={y + 28} width="44" height="5" rx="2.5" fill="rgba(255,255,255,0.14)" />
              </g>
            )}
          </g>
        );
      })}
    </g>
  ))}

  <!-- side panel -->
  <rect x="504" y="66" width="112" height="86" rx="10" fill="rgba(255,255,255,0.035)" stroke="rgba(255,255,255,0.08)" />
  <text x="518" y="86" font-size="8" fill="rgba(255,255,255,0.45)" font-family="sans-serif">Ocupación</text>
  <circle cx="560" cy="118" r="20" stroke="rgba(255,255,255,0.09)" stroke-width="6" />
  <circle cx="560" cy="118" r="20" stroke={accent} stroke-width="6" stroke-linecap="round"
    stroke-dasharray="88 126" transform="rotate(-90 560 118)" />

  <rect x="504" y="164" width="112" height="106" rx="10" fill="rgba(255,255,255,0.035)" stroke="rgba(255,255,255,0.08)" />
  <text x="518" y="184" font-size="8" fill="rgba(255,255,255,0.45)" font-family="sans-serif">Recaudado</text>
  {[26, 40, 32, 54, 46, 62].map((h, i) => (
    <rect x={518 + i * 15} y={252 - h} width="9" height={h} rx="3" fill={accent} fill-opacity={i === 5 ? 0.85 : 0.32} />
  ))}

  <rect x="504" y="282" width="112" height="94" rx="10" fill="rgba(255,255,255,0.035)" stroke="rgba(255,255,255,0.08)" />
  <text x="518" y="302" font-size="8" fill="rgba(255,255,255,0.45)" font-family="sans-serif">Próximos turnos</text>
  {[0, 1, 2].map((i) => (
    <g>
      <circle cx="524" cy={319 + i * 20} r="5.5" fill="rgba(255,255,255,0.12)" />
      <rect x="535" y={315.5 + i * 20} width="44" height="5" rx="2.5" fill="rgba(255,255,255,0.2)" />
      <rect x="535" y={323.5 + i * 20} width="26" height="4" rx="2" fill="rgba(255,255,255,0.1)" />
      <circle cx="606" cy={319 + i * 20} r="3" fill={i === 0 ? "#34d399" : "rgba(255,255,255,0.16)"} />
    </g>
  ))}
</svg>
