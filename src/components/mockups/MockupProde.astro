---
interface Props { accent?: string }
const { accent = "#a78bfa" } = Astro.props;
const board = [
  { pts: 128, w: 62 },
  { pts: 121, w: 48 },
  { pts: 117, w: 55 },
  { pts: 110, w: 42 },
  { pts: 104, w: 58 },
  { pts: 99, w: 46 },
];
---

<svg viewBox="0 0 640 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-full w-full">
  <rect width="640" height="400" rx="14" fill="#0a1018" />
  <rect x="0.5" y="0.5" width="639" height="399" rx="13.5" stroke="rgba(255,255,255,0.09)" />

  <path d="M0 14A14 14 0 0 1 14 0h612a14 14 0 0 1 14 14v18H0z" fill="rgba(255,255,255,0.035)" />
  <line x1="0" y1="32" x2="640" y2="32" stroke="rgba(255,255,255,0.08)" />
  <circle cx="18" cy="16" r="3.5" fill="rgba(255,255,255,0.18)" />
  <circle cx="30" cy="16" r="3.5" fill="rgba(255,255,255,0.13)" />
  <circle cx="42" cy="16" r="3.5" fill="rgba(255,255,255,0.13)" />
  <rect x="60" y="9" width="190" height="14" rx="7" fill="rgba(255,255,255,0.05)" />
  <text x="70" y="19.5" font-size="8" fill="rgba(255,255,255,0.4)" font-family="monospace">quiniprode</text>

  <!-- header -->
  <text x="24" y="60" font-size="13" font-weight="700" fill="rgba(255,255,255,0.92)" font-family="sans-serif">Mis pronósticos</text>
  <rect x="24" y="70" width="104" height="19" rx="9.5" fill={accent} fill-opacity="0.14" stroke={accent} stroke-opacity="0.38" />
  <circle cx="36" cy="79.5" r="3" fill={accent} />
  <text x="44" y="83" font-size="8" fill={accent} font-family="sans-serif">Grupo privado</text>
  <rect x="136" y="70" width="72" height="19" rx="9.5" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.08)" />
  <text x="147" y="83" font-size="8" fill="rgba(255,255,255,0.45)" font-family="sans-serif">Invitar</text>

  <!-- match cards -->
  {[0, 1, 2, 3].map((i) => {
    const y = 104 + i * 68;
    const locked = i > 1;
    return (
      <g>
        <rect x="24" y={y} width="336" height="56" rx="10" fill="rgba(255,255,255,0.035)" stroke={i === 0 ? accent : "rgba(255,255,255,0.08)"} stroke-opacity={i === 0 ? 0.35 : 1} />
        <text x="38" y={y + 17} font-size="7.5" fill="rgba(255,255,255,0.38)" font-family="sans-serif">Fase de grupos</text>
        <circle cx="42" cy={y + 36} r="7" fill="rgba(255,255,255,0.13)" />
        <rect x="54" y={y + 32} width="52" height="7" rx="3.5" fill="rgba(255,255,255,0.26)" />
        <circle cx="146" cy={y + 36} r="7" fill="rgba(255,255,255,0.13)" />
        <rect x="158" y={y + 32} width="46" height="7" rx="3.5" fill="rgba(255,255,255,0.26)" />
        <rect x="252" y={y + 24} width="24" height="24" rx="7" fill={locked ? "rgba(255,255,255,0.05)" : accent} fill-opacity={locked ? 1 : 0.22} stroke={locked ? "rgba(255,255,255,0.09)" : accent} stroke-opacity={locked ? 1 : 0.5} />
        <text x="264" y={y + 40} font-size="10" text-anchor="middle" fill={locked ? "rgba(255,255,255,0.3)" : "rgba(255,255,255,0.9)"} font-family="sans-serif">{locked ? "–" : i === 0 ? "2" : "1"}</text>
        <text x="288" y={y + 40} font-size="9" text-anchor="middle" fill="rgba(255,255,255,0.25)" font-family="sans-serif">vs</text>
        <rect x="300" y={y + 24} width="24" height="24" rx="7" fill={locked ? "rgba(255,255,255,0.05)" : accent} fill-opacity={locked ? 1 : 0.22} stroke={locked ? "rgba(255,255,255,0.09)" : accent} stroke-opacity={locked ? 1 : 0.5} />
        <text x="312" y={y + 40} font-size="10" text-anchor="middle" fill={locked ? "rgba(255,255,255,0.3)" : "rgba(255,255,255,0.9)"} font-family="sans-serif">{locked ? "–" : i === 0 ? "1" : "1"}</text>
        <circle cx="344" cy={y + 36} r="8" fill={locked ? "rgba(255,255,255,0.04)" : "rgba(52,211,153,0.16)"} />
        <path d={locked ? `M341 ${y + 36}h6M344 ${y + 33}v6` : `M340.5 ${y + 36.2}l2.6 2.6 4.6-5.2`} stroke={locked ? "rgba(255,255,255,0.3)" : "#34d399"} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    );
  })}

  <!-- leaderboard -->
  <rect x="376" y="104" width="240" height="272" rx="12" fill="rgba(255,255,255,0.035)" stroke="rgba(255,255,255,0.08)" />
  <text x="392" y="126" font-size="9" font-weight="600" fill="rgba(255,255,255,0.75)" font-family="sans-serif">Tabla de posiciones</text>
  <line x1="376" y1="138" x2="616" y2="138" stroke="rgba(255,255,255,0.07)" />
  {board.map((row, i) => {
    const y = 150 + i * 37;
    return (
      <g>
        {i === 0 && <rect x="384" y={y} width="224" height="32" rx="8" fill={accent} fill-opacity="0.1" stroke={accent} stroke-opacity="0.3" />}
        <text x="398" y={y + 20} font-size="9" fill={i === 0 ? accent : "rgba(255,255,255,0.35)"} font-family="sans-serif">{i + 1}</text>
        <circle cx="422" cy={y + 16} r="9" fill={i === 0 ? accent : "rgba(255,255,255,0.12)"} fill-opacity={i === 0 ? 0.4 : 1} />
        <rect x="438" y={y + 12.5} width={row.w} height="7" rx="3.5" fill={i === 0 ? "rgba(255,255,255,0.5)" : "rgba(255,255,255,0.24)"} />
        <rect x={568} y={y + 9} width="34" height="15" rx="7.5" fill={i === 0 ? accent : "rgba(255,255,255,0.05)"} fill-opacity={i === 0 ? 0.25 : 1} />
        <text x="585" y={y + 20} font-size="8.5" text-anchor="middle" fill={i === 0 ? "#fff" : "rgba(255,255,255,0.45)"} font-family="sans-serif">{row.pts}</text>
      </g>
    );
  })}
</svg>
