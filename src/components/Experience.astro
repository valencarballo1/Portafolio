---
import SectionHeader from "./SectionHeader.astro";
import Icon from "./Icon.astro";

const roles = [
  {
    company: "OSDOP",
    title: "Software Developer .NET",
    period: "Marzo 2022 — Actualidad",
    context: "Obra social · Sistemas internos usados a diario por múltiples áreas",
    bullets: [
      "Desarrollo y mantenimiento de aplicaciones web en .NET MVC en producción, con foco en rendimiento y continuidad del servicio.",
      "Relevamiento con las distintas áreas de la organización para traducir necesidades del negocio en desarrollos concretos.",
      "Trabajo sobre SQL Server: consultas, diseño de tablas y procedimientos almacenados que sostienen los procesos del sistema.",
      "Modernización de proyectos existentes para hacerlos más rápidos y más simples de mantener.",
    ],
  },
  {
    company: "Valb Solutions",
    title: "Desarrollador independiente · Proyectos propios",
    period: "2024 — Actualidad",
    context: "Productos propios y desarrollos a medida para clientes",
    bullets: [
      "Diseño y construcción de productos completos, del modelo de datos al despliegue en producción.",
      "Plataformas con usuarios reales: reservas y pagos para clubes, y una app de prode con más de 80 participantes.",
      "Contacto directo con el cliente: relevamiento, propuesta de alcance, desarrollo y puesta en marcha.",
    ],
  },
];
---

<section id="experiencia" class="section border-t border-white/6">
  <div class="shell">
    <SectionHeader
      eyebrow="Experiencia"
      title="Cuatro años escribiendo software que se usa"
      description="Trabajo en una organización con sistemas críticos en producción y, en paralelo, construyo mis propios productos. Las dos cosas se retroalimentan."
    />

    <div class="mt-14 space-y-4">
      {
        roles.map((role, i) => (
          <article class="reveal card p-6 md:p-8" style={`--reveal-delay:${i * 90}ms`}>
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <h3 class="text-xl font-semibold tracking-tight">{role.title}</h3>
                <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                  <span class="font-semibold text-brand-300">{role.company}</span>
                  <span class="text-mist/50" aria-hidden="true">·</span>
                  <span class="text-mist">{role.context}</span>
                </p>
              </div>
              <span class="chip shrink-0">{role.period}</span>
            </div>

            <ul class="mt-6 grid gap-3 border-t border-white/8 pt-6 md:grid-cols-2">
              {role.bullets.map((bullet) => (
                <li class="flex gap-2.5 text-[14.5px] leading-relaxed text-mist">
                  <Icon name="check" size={15} class="mt-1 shrink-0 text-brand-400" />
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
